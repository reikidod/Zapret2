<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Zapret2ControlCenter</AssemblyName>
    <RootNamespace>Zapret2.App</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-beta</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zapret2.Core\Zapret2.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\zapret-runtime.zip" LogicalName="Zapret2.App.Resources.zapret-runtime.zip" Condition="Exists('Resources\zapret-runtime.zip')" />
      <EmbeddedResource Include="..\..\native\target\x86_64-pc-windows-msvc\release\zapret2_native.dll"
                      LogicalName="Zapret2.App.Resources.zapret2_native.dll"
                      Condition="Exists('..\..\native\target\x86_64-pc-windows-msvc\release\zapret2_native.dll')" />
</ItemGroup>
</Project>
