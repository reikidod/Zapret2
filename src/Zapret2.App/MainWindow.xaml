<Window x:Class="Zapret2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret2 Control Center" Height="920" Width="1440" MinHeight="740" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}" Closing="Window_Closing" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#233B58" VerticalAlignment="Center">
                        <TextBlock Text="Z" FontSize="25" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ZAPRET2" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="NETWORK CONTROL" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="НАВИГАЦИЯ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,10"/>
                <StackPanel Grid.Row="3">
                    <Button x:Name="NavOverview" Tag="overview" Style="{StaticResource NavButtonStyle}" Content="◫   Обзор" Click="Navigate_Click" Background="#263A56" BorderBrush="#354F72"/>
                    <Button x:Name="NavProfiles" Tag="profiles" Style="{StaticResource NavButtonStyle}" Content="▤   Профили" Click="Navigate_Click"/>
                    <Button x:Name="NavLists" Tag="lists" Style="{StaticResource NavButtonStyle}" Content="☷   Списки" Click="Navigate_Click"/>
                    <Button x:Name="NavDiagnostics" Tag="diagnostics" Style="{StaticResource NavButtonStyle}" Content="⌁   Диагностика" Click="Navigate_Click"/>
                    <Button x:Name="NavSettings" Tag="settings" Style="{StaticResource NavButtonStyle}" Content="⚙   Настройки" Click="Navigate_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Margin="2,0,2,2">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>
                    <TextBlock Text="СЕАНС" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SidebarStatusText" Text="Не запущен" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <TextBlock Text="PORTABLE  /  WINDOWS X64" FontSize="10" Foreground="#8394A8" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header -->
        <Border Grid.Column="1" Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource SidebarBrush}">
            <Grid Margin="32,0,34,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Обзор" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Управление winws2, профилями и сетевыми списками" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AdminStatusDot" Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="AdminStatus" Text="Проверка прав..." FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="32,28,34,30">
            <!-- Overview -->
            <Grid x:Name="OverviewPage" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#17283B" BorderBrush="#314B6A" BorderThickness="1" CornerRadius="16" Padding="26" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Управление сетевым фильтром" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock Text="Запускайте проверенный профиль, отслеживайте процесс и быстро останавливайте его при необходимости." TextWrapping="Wrap" Foreground="#AFC0D7" FontSize="13" Margin="0,7,24,0"/>
                            <StackPanel Orientation="Horizontal" Margin="-4,14,0,0">
                                <Button x:Name="StartButton" Content="▶   Запустить" Style="{StaticResource AccentButtonStyle}" MinWidth="132" Click="StartStop_Click"/>
                                <Button x:Name="BlockcheckButton" Content="Проверка стратегий" Click="Blockcheck_Click"/>
                                <Button Content="Открыть журнал" Click="OpenDiagnostics_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="160">
                            <TextBlock Text="СОСТОЯНИЕ СЛУЖБЫ" FontSize="9" Foreground="#9DB1CC" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="RunStatus" Text="Остановлен" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                            <TextBlock x:Name="ActiveProfileText" Text="Профиль не выбран" FontSize="12" Foreground="#AFC0D7" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="WINWS2" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="WinwsStatusText" Text="Не найден" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="Исполняемый файл" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="LUA-БИБЛИОТЕКИ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="LuaStatusText" Text="Не найдены" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="zapret-lib.lua и связанные файлы" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="BLOCKCHECK2" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="BlockcheckStatusText" Text="Не найден" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="Инструмент диагностики" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,9,0">
                        <StackPanel>
                            <TextBlock Text="Быстрый старт" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="1. Укажите папку установленного zapret2 bundle.&#10;2. Выберите профиль и проверьте его аргументы.&#10;3. Запустите winws2 от имени администратора.&#10;4. При проблемах остановите процесс и проверьте журнал." TextWrapping="Wrap" LineHeight="24" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,14"/>
                            <WrapPanel>
                                <Button Content="Выбрать папку" Click="Browse_Click"/>
                                <Button Content="Найти автоматически" Click="Find_Click"/>
                                <Button Content="Перейти к профилям" Click="OpenProfiles_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="9,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Перед запуском" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Приложение управляет winws2, но не включает сам zapret2 и драйвер WinDivert. Не запускайте одновременно несколько DPI-фильтров: они могут конфликтовать." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,12"/>
                            <TextBlock Text="Профили являются примерами. Совместимость со Steam, Telegram Proxy, Valorant и другими программами зависит от конкретных правил и конфигурации." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Profiles -->
            <Grid x:Name="ProfilesPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="316"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Ваши профили" FontSize="16" FontWeight="SemiBold" Margin="4,3,0,3"/>
                            <TextBlock Text="Встроенные, Flowseal classic и пользовательские настройки winws2" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="4,3,0,12"/>
                        </StackPanel>
                        <ListBox x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged" DisplayMemberPath="Name"/>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <WrapPanel>
                                <Button Content="Новый" Click="NewProfile_Click"/>
                                <Button Content="Копия" Click="Duplicate_Click"/>
                                <Button Content="Удалить" Click="Delete_Click"/>
                            </WrapPanel>
                            <Button Content="Вернуть удалённые встроенные" Click="Restore_Click"/>
                            <WrapPanel>
                                <Button Content="Импорт JSON" Click="ImportProfiles_Click"/>
                                <Button Content="Экспорт JSON" Click="ExportProfiles_Click"/>
                            </WrapPanel>
                            <Button x:Name="ImportFlowsealButton" Content="Импортировать 22 стратегии Flowseal" ToolTip="Загрузить официальные BAT-профили Flowseal. BAT/CMD не запускаются." Click="ImportFlowseal_Click" Margin="0,7,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Название" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBox x:Name="ProfileName" Grid.Column="1" TextChanged="ProfileEditor_Changed"/>
                        <TextBlock x:Name="ProfileNote" Grid.Row="1" Grid.ColumnSpan="2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,12"/>
                        <TextBox x:Name="ArgumentsEditor" Grid.Row="2" Grid.ColumnSpan="2" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Code,Consolas" FontSize="13" TextChanged="ProfileEditor_Changed"/>
                        <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Импорт из .cmd/.bat" Click="Import_Click"/>
                            <Button Content="Проверить и скопировать команду" Click="ShowCommand_Click"/>
                            <Button Content="Сохранить" Style="{StaticResource AccentButtonStyle}" Click="SaveProfile_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Diagnostics -->
            <Grid x:Name="DiagnosticsPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="ПРОЦЕССЫ DPI" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ConflictStatusText" Text="Проверка не выполнялась" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="4,0">
                        <StackPanel><TextBlock Text="ПРАВА" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DiagnosticAdminText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="8,0,0,0">
                        <StackPanel><TextBlock Text="АКТИВНЫЙ ПРОФИЛЬ" FontSize="10" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DiagnosticProfileText" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                    </Border>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,14,0,14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Найденные компоненты" FontWeight="SemiBold" FontSize="14"/>
                            <Button DockPanel.Dock="Right" Content="Обновить проверку" Click="RefreshDiagnostics_Click" Margin="0"/>
                        </DockPanel>
                        <TextBlock x:Name="ComponentsStatus" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/>
                        <TextBlock x:Name="ConflictDetailsText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock Text="Журнал приложения" FontSize="14" FontWeight="SemiBold"/>
                            <WrapPanel DockPanel.Dock="Right"><Button Content="Папка логов" Click="OpenLogsFolder_Click" Margin="2,0"/><Button Content="Сохранить лог" Click="SaveLog_Click" Margin="2,0"/><Button Content="Очистить" Click="ClearLog_Click" Margin="2,0"/></WrapPanel>
                        </DockPanel>
                        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Code,Consolas" FontSize="12" Background="#0B1017" BorderThickness="0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Lists -->
            <ScrollViewer x:Name="ListsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Сетевые списки" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Обновляйте общие списки Flowseal отдельно от собственных правил. Перед заменой общих файлов создаётся резервная копия." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,18"/>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Общие списки" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ListsDirectoryText" Text="Папка списков не определена" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                            <TextBlock x:Name="ListsStatusText" Text="Выберите папку zapret2 bundle в настройках." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button x:Name="UpdateListsButton" Content="Обновить общие списки" Click="UpdateLists_Click" Style="{StaticResource AccentButtonStyle}"/>
                                <Button Content="Проверить файлы" Click="RefreshLists_Click"/>
                                <Button Content="Открыть папку lists" Click="OpenListsFolder_Click"/>
                            </WrapPanel>
                            <TextBlock Text="Источники: Flowseal/zapret-discord-youtube. Загружаются только текстовые списки; исполняемые файлы и драйверы не затрагиваются." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Пользовательские списки" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Эти файлы не перезаписываются при обновлении общих списков. Открывайте их в Блокноте, чтобы добавлять собственные домены или IP-исключения." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                            <ComboBox x:Name="UserListPicker" MinWidth="260" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button Content="Открыть в Блокноте" Click="OpenUserList_Click"/>
                                <Button Content="Создать отсутствующие файлы" Click="EnsureUserLists_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Параметры приложения" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Настройки хранятся отдельно от portable EXE и не удаляются при обновлении программы." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Папка zapret2 bundle" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Выберите распакованный комплект, содержащий winws2.exe и Lua-библиотеки." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Обзор…" Click="Browse_Click"/>
                                <TextBox x:Name="BasePath" TextChanged="BasePath_TextChanged" VerticalContentAlignment="Center"/>
                            </DockPanel>
                            <WrapPanel Margin="-4,8,0,0"><Button Content="Найти автоматически" Click="Find_Click"/><Button Content="Проверить компоненты" Click="RefreshDiagnostics_Click"/></WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Запуск и диагностика" FontSize="14" FontWeight="SemiBold"/>
                            <CheckBox x:Name="DebugCheck" Content="Добавлять --debug при запуске winws2" Checked="DebugCheck_Changed" Unchecked="DebugCheck_Changed"/>
                            <TextBlock Text="Отладочный режим может создавать больше сообщений в журнале. Включайте его только при поиске неисправностей." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="8,3,0,0"/>
                            <Button Content="Запросить права администратора" HorizontalAlignment="Left" Click="Admin_Click" Margin="4,14,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Резервные копии и данные" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Конфигурация автоматически сохраняется в %APPDATA%\Zapret2GUI. При записи создаётся резервная копия config.json.bak." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,10"/>
                            <WrapPanel><Button Content="Открыть папку настроек" Click="OpenConfigFolder_Click"/><Button Content="Экспортировать профили" Click="ExportProfiles_Click"/><Button Content="Импортировать профили" Click="ImportProfiles_Click"/></WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
